# LangSmith: use the same project for both terminal processes.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=voice-separate-langgraph
LANGSMITH_TRACING=true
LANGSMITH_TRACING_MODE=otel

# Enables W3C transport propagation where the LangGraph runtime supports it.
# The graph also installs a validated LangSmith distributed parent so its full
# callback tree nests under LiveKit in local and hosted server modes.
OTEL_ENABLED=true

# The LLM runs only inside the separately deployed LangGraph process.
OPENAI_API_KEY=
LANGGRAPH_MODEL=gpt-4o-mini

# Local LangGraph Server defaults. For a hosted deployment, use its HTTPS URL
# and API key instead.
LANGGRAPH_URL=http://127.0.0.1:2024
LANGGRAPH_ASSISTANT_ID=voice_agent
LANGGRAPH_API_KEY=
LANGGRAPH_TIMEOUT_SECONDS=45

# LiveKit cascade providers.
ASSEMBLYAI_API_KEY=
CARTESIA_API_KEY=
LIVEKIT_STT_MODEL=
LIVEKIT_TTS_MODEL=
LIVEKIT_TTS_VOICE=

# Console mode does not connect to a LiveKit room, but the SDK validates these.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_INPUT_DEVICE=
LIVEKIT_OUTPUT_DEVICE=
